#!/usr/bin/env python3
"""skills-sync — 把工具箱里的 skill 发布到 GitHub 仓库（默认 Sylvan-Luo/sylvan，公开）。

用法:
  skills-sync            同步并推送（= push）
  skills-sync push       整理 → 脱敏 → 隐私扫描 → 提交 → 推送
  skills-sync check      只整理 + 扫描，打印会改动哪些文件，不提交不推送
  skills-sync status     上次同步的结果、远端最新提交
  skills-sync list       列出会发布的 skill

来源（本机）:
  ~/tools/<名字>/                 工具代码（只取 git 已跟踪的文件）
  ~/.claude/skills/<名字>/        技能说明 SKILL.md 等（synced/ 是 Anthropic 自带的，不发布）
发布到仓库里:
  skills/<名字>/                  上面两处合并；README.md 首页的目录自动生成
脱敏表（只在本机，不进任何仓库）: ~/.config/skills-sync/scrub.tsv，每行「原文<TAB>替换成」。
不发布的名字: ~/tools/skills-sync/exclude.txt
"""
import os, re, sys, json, shutil, subprocess, datetime, fnmatch

HOME = os.path.expanduser('~')
TOOLS = os.path.join(HOME, 'tools')
SKILLS = os.path.join(HOME, '.claude', 'skills')
HERE = os.path.dirname(os.path.realpath(__file__))
REMOTE = os.environ.get('SKILLS_SYNC_REMOTE', 'git@github-sylvan:Sylvan-Luo/sylvan.git')
WEB = 'https://github.com/Sylvan-Luo/sylvan'
STATE = os.path.join(HOME, '.local', 'state', 'skills-sync')
STAGE = os.path.join(HOME, '.local', 'share', 'skills-sync', 'repo')
SCRUB = os.path.join(HOME, '.config', 'skills-sync', 'scrub.tsv')
AUTHOR = ('Sylvan-Luo', '202517378+Sylvan-Luo@users.noreply.github.com')
COAUTHOR = 'Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>'
SKIP_DIRS = {'synced', '_template'}
MAX_FILE = 5 * 1024 * 1024

# 通用的隐私/密钥特征：脱敏之后还命中就拒绝推送
LEAK_PATTERNS = [
    (r'\b100\.(6[4-9]|[7-9]\d|1[01]\d|12[0-7])\.\d{1,3}\.\d{1,3}\b', 'Tailscale IP'),
    (r'\b(?:192\.168|10)\.\d{1,3}\.\d{1,3}(?:\.\d{1,3})?\b', '局域网 IP'),
    (r'[A-Za-z0-9._%+-]+@(?!anthropic\.com|users\.noreply\.github\.com|example\.(?:com|org))[A-Za-z0-9-]+(?:\.[A-Za-z0-9-]+)*\.[A-Za-z]{2,}\b', '邮箱'),
    (r'\b(?:LAPTOP|DESKTOP)-[A-Z0-9]{5,}\b', 'Windows 电脑名'),
    (r'(?<!\d)1[3-9]\d{9}(?!\d)', '手机号'),
    (r'-----BEGIN [A-Z ]*PRIVATE KEY-----', '私钥'),
    (r'\b(?:ghp|gho|ghs|github_pat)_[A-Za-z0-9_]{20,}', 'GitHub token'),
    (r'\bsk-(?:ant-)?[A-Za-z0-9_-]{20,}', 'API key'),
    (r'\bAKIA[0-9A-Z]{16}\b', 'AWS key'),
    (r'(?i)(?:password|passwd|密码)\s*[:=：]\s*["\']?[^\s"\'<>{}()$]{4,}', '疑似密码'),
]


def sh(*a, cwd=None, check=True, capture=True):
    r = subprocess.run(a, cwd=cwd, text=True, capture_output=capture)
    if check and r.returncode:
        sys.exit(f'命令失败: {" ".join(a)}\n{r.stdout}{r.stderr}')
    return r.stdout if capture else ''


def git(*a, check=True):
    return sh('git', *a, cwd=STAGE, check=check)


def load_scrub():
    pairs = []
    if os.path.exists(SCRUB):
        for line in open(SCRUB, encoding='utf-8'):
            line = line.rstrip('\n')
            if not line or line.startswith('#') or '\t' not in line:
                continue
            a, b = line.split('\t', 1)
            pairs.append((a, b))
    pairs.sort(key=lambda p: -len(p[0]))  # 长的先换
    return pairs


def excluded():
    p = os.path.join(HERE, 'exclude.txt')
    if not os.path.exists(p):
        return set()
    return {l.strip() for l in open(p, encoding='utf-8') if l.strip() and not l.startswith('#')}


def tracked_tool_files(name):
    """~/tools/<name> 里 git 已跟踪（且没删）的文件，相对 <name> 的路径。"""
    out = sh('git', '-C', TOOLS, 'ls-files', '-z', '--', name, check=False)
    files = []
    for f in out.split('\0'):
        if f and os.path.isfile(os.path.join(TOOLS, f)):
            files.append(os.path.relpath(f, name))
    return files


def skill_files(name):
    d = os.path.join(SKILLS, name)
    files = []
    for root, dirs, fs in os.walk(d, followlinks=True):
        dirs[:] = [x for x in dirs if not x.startswith('.') and x != '__pycache__']
        for f in fs:
            if f.startswith('.') or f.endswith('.pyc'):
                continue
            files.append(os.path.relpath(os.path.join(root, f), d))
    return files


def collect():
    """返回 {名字: {相对路径: 源文件}}。"""
    names = set()
    for base in (TOOLS, SKILLS):
        for n in os.listdir(base):
            if n.startswith(('.', '_')) or n in SKIP_DIRS or not os.path.isdir(os.path.join(base, n)):
                continue
            names.add(n)
    names -= excluded()
    out = {}
    for n in sorted(names):
        m = {}
        for f in tracked_tool_files(n):
            m[f] = os.path.join(TOOLS, n, f)
        for f in skill_files(n):  # SKILL.md 以 ~/.claude/skills 为准
            m[f] = os.path.join(SKILLS, n, f)
        if m:
            out[n] = m
    return out


def frontmatter(path):
    try:
        t = open(path, encoding='utf-8').read()
    except OSError:
        return {}
    m = re.match(r'---\n(.*?)\n---', t, re.S)
    d = {}
    if m:
        for line in m.group(1).splitlines():
            if ':' in line and not line.startswith(' '):
                k, v = line.split(':', 1)
                d[k.strip()] = v.strip().strip('"\'')
    return d


def first_para(path):
    try:
        lines = open(path, encoding='utf-8').read().splitlines()
    except OSError:
        return ''
    for l in lines:
        l = l.strip()
        if l and not l.startswith(('#', '---', '`', '|', '-', '>')):
            return l
    return ''


def is_text(data):
    if b'\0' in data[:8192]:
        return False
    try:
        data.decode('utf-8')
        return True
    except UnicodeDecodeError:
        return False


def scrub_text(s, pairs):
    for a, b in pairs:
        s = s.replace(a, b)
    return s


def scan(rel, text, pairs):
    hits = []
    for i, line in enumerate(text.splitlines(), 1):
        for pat, what in LEAK_PATTERNS:
            for m in re.finditer(pat, line):
                hits.append(f'{rel}:{i}: {what}: {m.group(0)[:60]}')
        for a, _ in pairs:
            if a in line:
                hits.append(f'{rel}:{i}: 脱敏表里的原文没换掉: {a}')
    return hits


def ensure_stage():
    if os.path.isdir(os.path.join(STAGE, '.git')):
        git('fetch', '-q', 'origin')
        has = git('ls-remote', '--heads', 'origin', 'main').strip()
        if has:
            git('checkout', '-q', '-B', 'main', 'origin/main')
            git('reset', '-q', '--hard', 'origin/main')
        return
    os.makedirs(os.path.dirname(STAGE), exist_ok=True)
    sh('git', 'clone', '-q', REMOTE, STAGE)
    git('checkout', '-q', '-B', 'main')
    git('config', 'user.name', AUTHOR[0])
    git('config', 'user.email', AUTHOR[1])


def render_readme(skills, stamp):
    tpl = open(os.path.join(HERE, 'README.tpl.md'), encoding='utf-8').read()
    rows = []
    for n, files in skills.items():
        sk = os.path.join(STAGE, 'skills', n, 'SKILL.md')
        desc = frontmatter(sk).get('description') or first_para(os.path.join(STAGE, 'skills', n, 'README.md'))
        desc = desc.replace('|', '\\|')
        kind = 'skill + 工具' if 'SKILL.md' in files and len(files) > 1 else ('skill' if 'SKILL.md' in files else '工具')
        rows.append(f'| [{n}](skills/{n}/) | {kind} | {desc} |')
    return tpl.replace('{{TABLE}}', '\n'.join(rows)).replace('{{COUNT}}', str(len(skills))).replace('{{DATE}}', stamp)


def build(verbose=True):
    pairs = load_scrub()
    if not pairs:
        print(f'提醒：没有脱敏表 {SCRUB}（或是空的），只做通用扫描。', file=sys.stderr)
    skills = collect()
    ensure_stage()
    dst_root = os.path.join(STAGE, 'skills')
    shutil.rmtree(dst_root, ignore_errors=True)
    hits = []
    for n, files in skills.items():
        for rel, src in sorted(files.items()):
            data = open(src, 'rb').read()
            if len(data) > MAX_FILE:
                hits.append(f'{n}/{rel}: 文件太大（{len(data)//1024} KB），大文件应放 ~/data，不进仓库')
                continue
            dst = os.path.join(dst_root, n, rel)
            os.makedirs(os.path.dirname(dst), exist_ok=True)
            if is_text(data):
                t = scrub_text(data.decode('utf-8'), pairs)
                hits += scan(f'skills/{n}/{rel}', t, pairs)
                open(dst, 'w', encoding='utf-8').write(t)
            else:
                open(dst, 'wb').write(data)
            if os.access(src, os.X_OK):
                os.chmod(dst, 0o755)
    stamp = datetime.date.today().isoformat()
    readme = scrub_text(render_readme(skills, stamp), pairs)
    hits += scan('README.md', readme, pairs)
    open(os.path.join(STAGE, 'README.md'), 'w', encoding='utf-8').write(readme)
    for extra in ('LICENSE', '.gitignore'):
        p = os.path.join(HERE, 'repo-files', extra)
        if os.path.exists(p):
            shutil.copy(p, os.path.join(STAGE, extra))
    git('add', '-A')
    changed = git('status', '--porcelain').splitlines()
    if verbose:
        print(f'{len(skills)} 个：' + '、'.join(skills))
        print('\n'.join(changed) if changed else '没有改动')
    return skills, changed, hits


def discard():
    if git('rev-parse', '-q', '--verify', 'HEAD', check=False).strip():
        git('reset', '-q', '--hard'); git('clean', '-fdq')
    else:
        git('rm', '-rq', '--cached', '--ignore-unmatch', '.')
        for n in os.listdir(STAGE):
            if n != '.git':
                p = os.path.join(STAGE, n)
                shutil.rmtree(p) if os.path.isdir(p) else os.remove(p)


def save_state(d):
    os.makedirs(STATE, exist_ok=True)
    d['time'] = datetime.datetime.now().isoformat(timespec='seconds')
    json.dump(d, open(os.path.join(STATE, 'last.json'), 'w'), ensure_ascii=False, indent=1)


def changed_names(changed):
    names = set()
    for l in changed:
        p = l[3:].split(' -> ')[-1]
        names.add(p.split('/')[1] if p.startswith('skills/') else p)
    return sorted(names)


def push():
    skills, changed, hits = build()
    if hits:
        discard()
        save_state({'ok': False, 'error': '隐私扫描没通过', 'hits': hits[:50]})
        sys.exit('隐私扫描没通过，没有推送：\n  ' + '\n  '.join(hits[:50]) +
                 f'\n处理：改源文件，或把要替换的原文加进 {SCRUB}（原文<TAB>替换成）。')
    if not changed:
        save_state({'ok': True, 'note': '没有改动', 'head': git('rev-parse', '--short', 'HEAD', check=False).strip()})
        print('GitHub 上已经是最新的。')
        return
    last = sh('git', '-C', TOOLS, 'log', '-1', '--format=%s', check=False).strip()
    names = changed_names(changed)
    msg = f'同步：{"、".join(names)}\n\n工具箱最近一次提交：{last}\n\n{COAUTHOR}\n'
    git('commit', '-q', '-m', msg)
    r = subprocess.run(['git', 'push', '-q', 'origin', 'main'], cwd=STAGE, text=True, capture_output=True)
    if r.returncode:
        save_state({'ok': False, 'error': 'push 失败', 'detail': r.stderr[-2000:]})
        sys.exit('推送失败：\n' + r.stderr)
    head = git('rev-parse', '--short', 'HEAD').strip()
    save_state({'ok': True, 'head': head, 'changed': names})
    print(f'已推送 {head}：{"、".join(names)}\n{WEB}')


def main():
    a = sys.argv[1:] or ['push']
    c = a[0]
    if c in ('-h', '--help', 'help'):
        print(__doc__)
    elif c == 'push':
        push()
    elif c == 'check':
        skills, changed, hits = build()
        discard()
        print('隐私扫描：' + ('通过' if not hits else '没通过\n  ' + '\n  '.join(hits)))
        sys.exit(1 if hits else 0)
    elif c == 'list':
        for n, files in collect().items():
            print(f'{n:16} {len(files)} 个文件')
    elif c == 'status':
        p = os.path.join(STATE, 'last.json')
        print(open(p).read() if os.path.exists(p) else '还没同步过')
        print(sh('git', 'ls-remote', REMOTE, 'main', check=False).strip() or '远端还没有 main')
    else:
        sys.exit(__doc__)


if __name__ == '__main__':
    main()
